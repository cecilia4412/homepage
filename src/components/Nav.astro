---
const path = Astro.url.pathname
const isActive = (p: string) =>
  p === '/' ? path === '/' : path.startsWith(p)
---

<header class="nav" id="nav">
  <div class="nav-inner">
    <a href="/" class="logo" aria-label="首页">
      <span class="logo-badge">C</span>
      <span class="logo-name">cecilia</span>
    </a>

    <nav class="nav-links" aria-label="主导航">
      <a href="/" class:list={[{ active: isActive('/') }]}>主页</a>
      <a href="/blog" class:list={[{ active: isActive('/blog') }]}>笔记</a>
      <a href="/nav" class:list={[{ active: isActive('/nav') }]}>网站导航</a>
    </nav>
  </div>
</header>

<script>
  const nav = document.getElementById('nav')!

  const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 8)
  onScroll()
  window.addEventListener('scroll', onScroll, { passive: true })
</script>
